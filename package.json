{
  "scripts": {
    "start": "cds-serve"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@cap-js/postgres": "^3.1.1",
    "@sap/cds": "^10.1.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds-dk": "^10"
  },
  "cds": {
    "requires": {
      "db": {
        "[production]": {
          "kind": "hana"
        }
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "requester1": {
              "password": "requester1",
              "roles": [
                "Requester"
              ]
            },
            "requester2": {
              "password": "requester2",
              "roles": [
                "Requester"
              ]
            },
            "approver": {
              "password": "approver",
              "roles": [
                "Approver"
              ]
            }
          }
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "engines": {
    "node": "^24"
  }
}